{
  "datasets": [
    {
      "name": "trips_by_rain_bucket",
      "displayName": "Trips by Rain Bucket",
      "config": {
        "version": "1.1",
        "source": "workspace.taxi_lakehouse.gold_demand_by_zone_hour",
        "dimensions": [
          {
            "name": "rain_bucket",
            "expr": "CASE\n  WHEN precip_mm IS NULL THEN 'Unknown'\n  WHEN precip_mm = 0 THEN '0 mm (Dry)'\n  WHEN precip_mm < 2.5 THEN '0-2.5 mm (Light)'\n  WHEN precip_mm < 7.6 THEN '2.5-7.6 mm (Moderate)'\n  ELSE '7.6+ mm (Heavy)'\nEND"
          }
        ],
        "measures": [
          {
            "name": "total_trips",
            "expr": "SUM(trips)"
          }
        ]
      }
    },
    {
      "name": "hourly_trips_weather",
      "displayName": "Hourly Trips vs Precipitation",
      "config": {
        "version": "1.1",
        "source": "workspace.taxi_lakehouse.gold_demand_by_zone_hour",
        "dimensions": [
          {
            "name": "hour_ts",
            "expr": "hour_ts"
          }
        ],
        "measures": [
          {
            "name": "total_trips",
            "expr": "SUM(trips)"
          },
          {
            "name": "avg_precipitation_mm",
            "expr": "AVG(precip_mm)"
          }
        ]
      }
    },
    {
      "name": "top_zones_rain_vs_dry",
      "displayName": "Top Pickup Zones: Heavy Rain vs Dry",
      "config": {
        "version": "1.1",
        "source": "WITH zone_hour AS (\n  SELECT\n    pickup_zone,\n    CASE\n      WHEN precip_mm >= 7.6 THEN 'Heavy Rain'\n      WHEN precip_mm = 0 THEN 'Dry'\n    END AS rain_condition,\n    trips\n  FROM workspace.taxi_lakehouse.gold_demand_by_zone_hour\n), zone_totals AS (\n  SELECT\n    pickup_zone,\n    SUM(CASE WHEN rain_condition = 'Heavy Rain' THEN trips ELSE 0 END) AS heavy_trips,\n    SUM(CASE WHEN rain_condition = 'Dry' THEN trips ELSE 0 END) AS dry_trips\n  FROM zone_hour\n  GROUP BY pickup_zone\n), ranked AS (\n  SELECT\n    pickup_zone,\n    heavy_trips,\n    dry_trips,\n    ROW_NUMBER() OVER (ORDER BY heavy_trips DESC, dry_trips DESC) AS rn\n  FROM zone_totals\n) SELECT pickup_zone, 'Heavy Rain' AS rain_condition, heavy_trips AS trips FROM ranked WHERE rn <= 10 UNION ALL SELECT pickup_zone, 'Dry' AS rain_condition, dry_trips AS trips FROM ranked WHERE rn <= 10",
        "dimensions": [
          {
            "name": "pickup_zone",
            "expr": "pickup_zone"
          },
          {
            "name": "rain_condition",
            "expr": "rain_condition"
          }
        ],
        "measures": [
          {
            "name": "total_trips",
            "expr": "SUM(trips)"
          }
        ]
      }
    }
  ],
